# ──────────────────────────────────────────────────────────────────────────────
# JanSamadhan — Environment Variable Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running the app.
#
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored on purpose.
# This file (.env.example) is safe to commit; it contains only placeholders.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL / Prisma) ────────────────────────────────────────────
# All three variables must point to the same connection string.
# Prisma reads DATABASE_URL from schema.prisma; POSTGRES_URL and
# PRISMA_DATABASE_URL are used by hosting platforms (e.g. Vercel, Railway).
DATABASE_URL="postgres://username:password@host:5432/dbname?sslmode=require"
POSTGRES_URL="postgres://username:password@host:5432/dbname?sslmode=require"
PRISMA_DATABASE_URL="postgres://username:password@host:5432/dbname?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
# Secret key used to sign and verify JWT session tokens.
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET="replace-me-with-a-long-random-secret"

# ── App URL ───────────────────────────────────────────────────────────────────
# Full public URL of the app. Used for absolute URL construction server-side.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google Maps ───────────────────────────────────────────────────────────────
# Browser-safe API key with Maps JavaScript API enabled.
# Obtain one from https://console.cloud.google.com/google/maps-apis/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"
